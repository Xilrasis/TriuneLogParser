<Window x:Class="TriuneLogParser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TriuneLogParser.App.ViewModels"
        Title="TriuneLogParser" Height="720" Width="1180"
        Background="{StaticResource Bg}" MinWidth="900" MinHeight="500">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
        <!-- Also registered as a global hotkey (works while the game has focus). -->
        <KeyBinding Key="S" Modifiers="Control+Alt" Command="{Binding SplitFightCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <!-- top bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" Padding="12,9" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Character" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="220" ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" Foreground="{StaticResource Text}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Content="Reload (F5)" Command="{Binding ReloadCommand}" Margin="8,0,0,0" />
                    <Button Content="Clear encounter history" Command="{Binding RestartFreshCommand}" Margin="8,0,0,0"
                            ToolTip="Drop all parsed encounters and keep following the log from now (reload with no history lookback)." />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <ToggleButton Content="Follow live" IsChecked="{Binding AutoFollow}" />
                    <Button Content="✂ Split fight" Command="{Binding SplitFightCommand}" Margin="8,0,0,0"
                            ToolTip="End the current encounter now; the next combat starts a fresh one (Ctrl+Alt+S). Saved beside the log so re-parses match." />
                    <ToggleButton Content="Overlay" IsChecked="{Binding OverlayVisible}" Margin="8,0,0,0" />
                    <Button Content="{Binding OverlayClickThroughText}" Command="{Binding ToggleClickThroughCommand}" Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding ZoneText}" Style="{StaticResource Dim}"
                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding EverQuestFolder}" Style="{StaticResource Dim}" VerticalAlignment="Center"
                               MaxWidth="240" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    <Button Content="⚙ Settings" Command="{Binding SettingsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" Padding="12,5" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Dim}" />
        </Border>

        <!-- setup hint -->
        <Border DockPanel.Dock="Top" Background="#3a2f1c" Padding="12,8" Visibility="{Binding NeedsSetup, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠  Set your EverQuest folder to begin — the one that contains the 'logs' folder." VerticalAlignment="Center" />
                <Button Content="Choose folder…" Command="{Binding ChangeFolderCommand}" Margin="12,0,0,0" />
            </StackPanel>
        </Border>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="300" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- encounter list -->
            <Border Background="{StaticResource Panel}" CornerRadius="6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Encounters  (Ctrl/Shift-click to group)" Style="{StaticResource Dim}" Margin="10,8" />
                    <ListView x:Name="EncounterList" Background="Transparent" BorderThickness="0"
                              ItemsSource="{Binding Encounters}" SelectionMode="Extended"
                              SelectionChanged="EncounterList_SelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="5,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="8,4">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Panel2}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BarActive}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EncounterRowViewModel}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding StatusGlyph}" Foreground="{StaticResource Good}" FontSize="11"
                                                   Width="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding StartText}" Style="{StaticResource Dim}" VerticalAlignment="Center" />
                                        <TextBlock Text="  ·  " Style="{StaticResource Dim}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DurationText}" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding DeathsText}" Foreground="{StaticResource Danger}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding TopText}" Style="{StaticResource Dim}" Margin="12,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- breakdown -->
            <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="6">
                <DockPanel Margin="12">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="Export…" Command="{Binding ExportCommand}" />
                        <Button DockPanel.Dock="Right" Content="Follow live fight" Command="{Binding FollowLiveCommand}" Margin="0,0,8,0" />
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Content="Damage done" Click="Metric_Click" Tag="DamageDone"
                                          IsChecked="{Binding Metric, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=DamageDone}" />
                            <ToggleButton Content="Damage taken" Click="Metric_Click" Tag="DamageTaken" Margin="6,0,0,0"
                                          IsChecked="{Binding Metric, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=DamageTaken}" />
                            <ToggleButton Content="Healing" Click="Metric_Click" Tag="Healing" Margin="6,0,0,0"
                                          IsChecked="{Binding Metric, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Healing}" />
                            <ToggleButton Content="Mobs" Click="Metric_Click" Tag="Mobs" Margin="6,0,0,0"
                                          IsChecked="{Binding Metric, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Mobs}" />
                        </StackPanel>
                    </DockPanel>

                    <TextBlock DockPanel.Dock="Top" Text="{Binding BreakdownHeader}" Style="{StaticResource Dim}" Margin="2,0,0,8" />

                    <ScrollViewer x:Name="BreakdownScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  SizeChanged="BreakdownScroll_SizeChanged">
                        <ItemsControl ItemsSource="{Binding Nodes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BreakdownNode}">
                                    <Border Margin="0,1" MinHeight="34" Cursor="Hand" MouseLeftButtonUp="Node_Click"
                                            HorizontalAlignment="Left" ClipToBounds="True"
                                            Width="{Binding ActualWidth, ElementName=BreakdownScroll}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#26282d" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="top">
                                                        <Setter Property="Background" Value="{StaticResource Panel2}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="3" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,3,10,2">
                                                <!-- name + info (left) -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Width="392"
                                                            Margin="{Binding IndentThickness}">
                                                    <TextBlock Text="{Binding Glyph}" FontSize="10" FontWeight="Bold" Width="16"
                                                               Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{StaticResource Text}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="FontWeight" Value="Normal" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="top">
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                                <Setter Property="FontSize" Value="13" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="group">
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Sub}" Style="{StaticResource Dim}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding DetailText}" Style="{StaticResource Dim}" FontSize="10"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Visibility="{Binding DetailText, Converter={StaticResource EmptyToCollapsed}}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- total + percent (centre) -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Width="188">
                                                    <TextBlock Text="{Binding ValueText}" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource Text}"
                                                               Width="118" />
                                                    <TextBlock Text="{Binding ShareText}" FontFamily="Consolas" Style="{StaticResource Dim}"
                                                               Margin="10,0,0,0" Width="52" />
                                                </StackPanel>

                                                <!-- dps (right) -->
                                                <TextBlock Text="{Binding RateText}" FontFamily="Consolas" FontSize="13"
                                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" Width="100" />
                                            </StackPanel>

                                            <!-- proportional percentage bar -->
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding BarFraction, Converter={StaticResource FractionStar}}" />
                                                    <ColumnDefinition Width="{Binding BarFraction, Converter={StaticResource FractionRestStar}}" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" CornerRadius="1.5">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#4b73a8" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Kind}" Value="top">
                                                                    <Setter Property="Background" Value="{StaticResource Accent}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
