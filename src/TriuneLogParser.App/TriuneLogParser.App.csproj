    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TriuneLogParser.Core\TriuneLogParser.Core.csproj" />
  </ItemGroup>

</Project>
