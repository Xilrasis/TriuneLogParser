<Window x:Class="TriuneLogParser.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TriuneLogParser.App.ViewModels"
        Title="TriuneLogParser Overlay"
        WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False"
        Topmost="True" ResizeMode="CanResizeWithGrip"
        Background="Transparent" MinWidth="160" MinHeight="90"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Border x:Name="Root" CornerRadius="6" Background="#1b1c1f" BorderBrush="#3a3d44" BorderThickness="1"
            MouseLeftButtonDown="Root_DragMove">
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
        </Border.LayoutTransform>

        <DockPanel>
            <!-- header -->
            <Grid DockPanel.Dock="Top" Background="#232428" Height="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Foreground="#e7e8ea" FontSize="11" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <TextBlock Text="{Binding Subtitle}" Foreground="#9aa0a6" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Button Content="⚙" Width="18" Height="18" Padding="0" FontSize="10" Click="Settings_Click"
                            Background="Transparent" Foreground="#9aa0a6" BorderThickness="0" Cursor="Hand" />
                    <Button Content="✕" Width="18" Height="18" Padding="0" FontSize="10" Click="Close_Click"
                            Background="Transparent" Foreground="#9aa0a6" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </Grid>

            <!-- settings panel -->
            <Border x:Name="SettingsPanel" DockPanel.Dock="Top" Background="#2b2d32" Padding="8" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Metric" Foreground="#9aa0a6" FontSize="10" Width="60" VerticalAlignment="Center" />
                        <Button Content="◀" Width="20" Click="MetricPrev_Click" />
                        <TextBlock Text="{Binding MetricLabel}" Foreground="#e7e8ea" FontSize="10" VerticalAlignment="Center"
                                   TextAlignment="Center" MinWidth="90" />
                        <Button Content="▶" Width="20" Click="MetricNext_Click" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Opacity" Foreground="#9aa0a6" FontSize="10" Width="60" VerticalAlignment="Center" />
                        <Slider x:Name="OpacitySlider" Minimum="0.15" Maximum="1" Value="0.82" TickFrequency="0.05"
                                ValueChanged="OpacitySlider_Changed" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Scale" Foreground="#9aa0a6" FontSize="10" Width="60" VerticalAlignment="Center" />
                        <Slider x:Name="ScaleSlider" Minimum="0.7" Maximum="2" Value="1" TickFrequency="0.1"
                                ValueChanged="ScaleSlider_Changed" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Rows" Foreground="#9aa0a6" FontSize="10" Width="60" VerticalAlignment="Center" />
                        <Slider x:Name="RowsSlider" Minimum="1" Maximum="20" Value="8" IsSnapToTickEnabled="True" TickFrequency="1"
                                ValueChanged="RowsSlider_Changed" />
                    </DockPanel>
                    <CheckBox x:Name="ClickThroughCheck" Content="Click-through" Foreground="#c8c8c8" FontSize="10"
                              Margin="0,2,0,0" Click="ClickThrough_Click" />
                </StackPanel>
            </Border>

            <!-- bars -->
            <ItemsControl ItemsSource="{Binding Bars}" Margin="4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:OverlayBar}">
                        <Border Height="18" Margin="0,1" CornerRadius="3" Background="#26282c" ClipToBounds="True">
                            <Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionStar}}" />
                                        <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionRestStar}}" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{Binding Color}" Opacity="0.85" />
                                </Grid>
                                <DockPanel Margin="6,0,6,0">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" Foreground="#f2f3f4" FontSize="11"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding RateText}" Foreground="#dfe3ea" FontFamily="Consolas" FontSize="11"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding ShareText}" Foreground="#c8ccd2" FontFamily="Consolas" FontSize="10"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                    <TextBlock Text="{Binding ValueText}" Foreground="#c8ccd2" FontFamily="Consolas" FontSize="10"
                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                </DockPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Border>
</Window>
