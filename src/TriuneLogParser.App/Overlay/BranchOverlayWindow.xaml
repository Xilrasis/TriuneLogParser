<Window x:Class="TriuneLogParser.App.Overlay.BranchOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TriuneLogParser.App.ViewModels"
        Title="TriuneLogParser — player breakdown"
        WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False"
        Topmost="True" ResizeMode="CanResize"
        Background="Transparent" MinWidth="180" MinHeight="60"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

  <Grid>
    <Border x:Name="Root" CornerRadius="6" Background="#1b1c1f" BorderBrush="#8a6d3b" BorderThickness="1"
            MouseLeftButtonDown="Root_DragMove">
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
        </Border.LayoutTransform>

        <DockPanel>
            <Grid DockPanel.Dock="Top" Background="#2a2620" Height="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Foreground="#e7e8ea" FontSize="11" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="#9aa0a6" FontSize="10" VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="18" Height="18" Padding="0" FontSize="10" Click="Close_Click"
                        Margin="0,0,4,0" Background="Transparent" Foreground="#9aa0a6" BorderThickness="0" Cursor="Hand" />
            </Grid>

            <Grid x:Name="HeaderCols" DockPanel.Dock="Top" Height="15" Margin="11,3,11,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="HdrName" />
                    <ColumnDefinition x:Name="HdrMid" />
                    <ColumnDefinition x:Name="HdrRate" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Source" Foreground="#8a9096" FontSize="9" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Total" Foreground="#8a9096" FontSize="9"
                           TextAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="Rate" Foreground="#8a9096" FontSize="9" VerticalAlignment="Center" />
                <GridSplitter Grid.Column="0" Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                              Background="#33ffffff" ShowsPreview="False" ResizeBehavior="CurrentAndNext" ResizeDirection="Columns"
                              IsEnabled="{Binding ColumnsUnlocked}" DragCompleted="ColumnSplitter_DragCompleted" />
                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                              Background="#33ffffff" ShowsPreview="False" ResizeBehavior="CurrentAndNext" ResizeDirection="Columns"
                              IsEnabled="{Binding ColumnsUnlocked}" DragCompleted="ColumnSplitter_DragCompleted" />
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="4">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource OverlayScrollBar}" />
                </ScrollViewer.Resources>
            <ItemsControl x:Name="BarList" ItemsSource="{Binding Bars}">
                <ItemsControl.Resources>
                    <DropShadowEffect x:Key="TextShadow" ShadowDepth="1" BlurRadius="3" Direction="315"
                                      Color="#000000" Opacity="1" />
                </ItemsControl.Resources>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:OverlayBar}">
                        <Border Height="22" Margin="0,2" CornerRadius="3" Background="#202226" ClipToBounds="True">
                            <Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionStar}}" />
                                        <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionRestStar}}" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{Binding Color}" Opacity="0.55" />
                                </Grid>
                                <Grid Margin="7,0,7,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding NameCol}" />
                                        <ColumnDefinition Width="{Binding MidCol}" />
                                        <ColumnDefinition Width="{Binding RateCol}" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Effect="{StaticResource TextShadow}" />
                                    <TextBlock Grid.Column="1" Text="{Binding CenterText}" Foreground="#eef0f2" FontFamily="Consolas" FontSize="11"
                                               VerticalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Effect="{StaticResource TextShadow}" />
                                    <TextBlock Grid.Column="2" Text="{Binding DpsText}" Foreground="White" FontWeight="SemiBold" FontFamily="Consolas"
                                               FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Effect="{StaticResource TextShadow}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>

    <Thumb x:Name="ResizeGrip" Style="{StaticResource OverlayResizeGrip}" DragDelta="ResizeGrip_DragDelta" />
  </Grid>
</Window>
