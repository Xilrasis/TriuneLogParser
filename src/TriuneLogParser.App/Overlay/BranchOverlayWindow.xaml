<Window x:Class="TriuneLogParser.App.Overlay.BranchOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TriuneLogParser.App.ViewModels"
        Title="TriuneLogParser — player breakdown"
        WindowStyle="None" AllowsTransparency="True" ShowInTaskbar="False"
        Topmost="True" ResizeMode="CanResize" SizeToContent="Height"
        Background="Transparent" MinWidth="180" MinHeight="50"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <Border x:Name="Root" CornerRadius="6" Background="#1b1c1f" BorderBrush="#8a6d3b" BorderThickness="1"
            MouseLeftButtonDown="Root_DragMove">
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Scale}" ScaleY="{Binding Scale}" />
        </Border.LayoutTransform>

        <DockPanel>
            <Grid DockPanel.Dock="Top" Background="#2a2620" Height="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" Foreground="#e7e8ea" FontSize="11" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="#9aa0a6" FontSize="10" VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="18" Height="18" Padding="0" FontSize="10" Click="Close_Click"
                        Margin="0,0,4,0" Background="Transparent" Foreground="#9aa0a6" BorderThickness="0" Cursor="Hand" />
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="4">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource OverlayScrollBar}" />
                </ScrollViewer.Resources>
            <ItemsControl x:Name="BarList" ItemsSource="{Binding Bars}">
                <ItemsControl.Resources>
                    <DropShadowEffect x:Key="TextShadow" ShadowDepth="1" BlurRadius="3" Direction="315"
                                      Color="#000000" Opacity="1" />
                </ItemsControl.Resources>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:OverlayBar}">
                        <Border Height="22" Margin="0,2" CornerRadius="3" Background="#202226" ClipToBounds="True">
                            <Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionStar}}" />
                                        <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionRestStar}}" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{Binding Color}" Opacity="0.55" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="7,0,7,0"
                                            Width="{Binding ActualWidth, ElementName=BarList}">
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="12"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Width="128"
                                               Effect="{StaticResource TextShadow}" />
                                    <TextBlock Text="{Binding CenterText}" Foreground="#eef0f2" FontFamily="Consolas" FontSize="11"
                                               VerticalAlignment="Center" TextAlignment="Center" Width="140"
                                               Effect="{StaticResource TextShadow}" />
                                    <TextBlock Text="{Binding DpsText}" Foreground="White" FontWeight="SemiBold" FontFamily="Consolas"
                                               FontSize="12" VerticalAlignment="Center" Width="80"
                                               Effect="{StaticResource TextShadow}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
